#!/usr/bin/env bash
# sbomgate — SBOM (CycloneDX + SPDX) + CVE scan (grype + trivy) + policy gate + evidence verification.
# One command, identical behaviour in the container and natively on macOS/Linux/Windows(Git Bash).
# bash 3.2 compatible on purpose (macOS ships 3.2): no associative arrays, no ${x,,}.
#
#   sbomgate scan --source DIR [--image-tar FILE | --image REF] [--out DIR] [--name NAME]
#                 [--label VERSION] [--fail-on CRITICAL|HIGH|MEDIUM|LOW|none]  (default HIGH)
#                 [--allowlist FILE] [--only-fixed] [--no-trivy] [--source-url URL] [--source-ref REF]
#   sbomgate verify-release --bundle-dir DIR [--expect-sha SHA] [--trusted-keys F] [--at YYYY-MM-DD]
#                 [--allow-fail-result] [--skip-signature] [--json]     # offline evidence check
#   sbomgate verify-toolkit --image REF@sha256:... [--trusted-keys F] [--at YYYY-MM-DD] [--attestation] [--json]
#   sbomgate check-tools [--lock FILE] [--json]   # sha256 of syft grype trivy yq jq cosign vs tools.lock
#   sbomgate key-entry --pub cosign.pub --id ID --purpose interim|hardware --days N [--from YYYY-MM-DD] [--note T]
#   sbomgate key-status --pub cosign.pub [--trusted-keys F] [--at YYYY-MM-DD] [--json]
#   sbomgate tools        # versions of every bundled tool, as JSON
#   sbomgate version      # toolkit version
#   sbomgate exit-codes [--json]   # the exit-code contract below
#
# Exit codes (1.3.0+; a caller can branch on them without reading any text):
#   0  PASS            gate passed / verification passed
#   1  ERROR           unclassified tool error (anything not below; every error was 1 before 1.3.0)
#   2  FINDINGS        CVEs at or above --fail-on (also when a cross-check scanner was unavailable)
#   3  UNAVAILABLE     an external resource could not be got: vulnerability DB download, registry, network
#   4  UNTRUSTED       signature does not verify / no usable trusted key / binary != tools.lock / evidence tampered
#   5  POLICY          allowlist entry incomplete or expired, trusted-keys file malformed, bad --fail-on
#   64 USAGE           unknown argument, missing required argument, wrong input path
set -euo pipefail

SBOMGATE_HOME="${SBOMGATE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
TOOLKIT_VERSION="$(tr -d '[:space:]' < "$SBOMGATE_HOME/VERSION" 2>/dev/null || echo 0.0.0-dev)"
TODAY="$(date -u +%Y-%m-%d)"
# never phone home for a newer syft/grype release: offline that check logs a network ERROR that has
# nothing to do with the scan (and would read like an unavailable vulnerability DB)
export GRYPE_CHECK_FOR_APP_UPDATE=false SYFT_CHECK_FOR_APP_UPDATE=false
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

EX_PASS=0 EX_ERROR=1 EX_FINDINGS=2 EX_UNAVAILABLE=3 EX_UNTRUSTED=4 EX_POLICY=5 EX_USAGE=64
log()  { printf '[sbomgate %s] %s\n' "$(date -u +%H:%M:%S)" "$*" >&2; }
# Every error line carries its class in brackets, so a log reader sees the same thing the exit code says.
die()             { printf '[sbomgate] ERROR [error]: %s\n' "$*" >&2; exit "$EX_ERROR"; }
die_usage()       { printf '[sbomgate] ERROR [usage]: %s\n' "$*" >&2; exit "$EX_USAGE"; }
die_policy()      { printf '[sbomgate] ERROR [policy]: %s\n' "$*" >&2; exit "$EX_POLICY"; }
die_unavailable() { printf '[sbomgate] ERROR [unavailable]: %s\n' "$*" >&2; exit "$EX_UNAVAILABLE"; }
die_untrusted()   { printf '[sbomgate] ERROR [untrusted]: %s\n' "$*" >&2; exit "$EX_UNTRUSTED"; }
# "Could not get it at all": only unambiguous network / pull / DB-download failures, and never from a
# WARN line (grype WARNs "unable to check for vulnerability database update ... dial tcp" and then scans
# fine with the DB it has). Prints the first matching line; returns 1 when the file names no such failure.
NET_FAILURE_RE='dial tcp|no such host|network is unreachable|connection refused|connection reset by peer|i/o timeout|tls handshake timeout|context deadline exceeded|temporary failure in name resolution|could not resolve host|server misbehaving|failed to resolve reference|failed to do request|unable to find image|failed to download vulnerability db|failed to download artifact|unable to download listing|oci repository error|oci artifact error|vulnerability database was built.*max allowed'
WARN_LINE_RE='(^|[^A-Za-z])WARN(ING)?([^A-Za-z]|$)'
net_failure_line() {  # $1 file with a tool's stderr
  [ -s "$1" ] || return 1
  local l w; l="$(grep -v -E "$WARN_LINE_RE" "$1" | grep -i -E -m1 "$NET_FAILURE_RE" || true)"
  if [ -z "$l" ]; then
    # grype's own shape when it has no usable DB and cannot fetch one: the refresh failure is logged
    # at WARN, the fatal line only says the DB would not load. Both halves are needed: a DB that does
    # not load for any other reason (corrupt file, full disk) stays an ordinary error.
    l="$(grep -v -E "$WARN_LINE_RE" "$1" | grep -i -E -m1 'failed to load vulnerability db' || true)"
    w="$(grep -E "$WARN_LINE_RE" "$1" | grep -i -E -m1 "$NET_FAILURE_RE" || true)"
    [ -n "$l" ] && [ -n "$w" ] || return 1
    l="$l (DB refresh failed: $w)"
  fi
  printf '%s' "$l" | sed "s/$(printf '\033')\[[0-9;]*m//g" | cut -c1-400
}
net_endpoints() {  # $1 file -> JSON array of hosts named by URL or "lookup <host>" on the deciding lines (max 3)
  { grep -v -E "$WARN_LINE_RE" "$1" 2>/dev/null | grep -i -E "$NET_FAILURE_RE"
    grep -E "$WARN_LINE_RE" "$1" 2>/dev/null | grep -i -E "$NET_FAILURE_RE"; } \
    | grep -o -E 'https?://[A-Za-z0-9.-]+(:[0-9]+)?|lookup [A-Za-z0-9.-]+' \
    | sed -E 's#^https?://##; s#^lookup ##; s#[.]$##' | awk '!seen[$0]++' | head -3 | jq -R -s 'split("\n") | map(select(length > 0))'
}
need() { command -v "$1" >/dev/null 2>&1 || die "required tool not on PATH: $1"; }
# bind mounts are often owned by another uid: without safe.directory git refuses and the git filter would silently skip
g() { git -c safe.directory='*' "$@"; }
abspath() { ( cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd)" "$(basename "$1")" ); }
# Windows/Git Bash: the scanners are native .exe and only understand C:\ paths; MSYS converts bare
# arguments but not `dir:/d/...` or `-o fmt=/d/...`, so every tool-facing path goes through this.
wpath() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) cygpath -w "$1";; *) printf '%s' "$1";; esac; }
# sha256 of a file / of stdin: sha256sum (Linux, Git Bash) or shasum -a 256 (macOS)
sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
sha256_stdin() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
file_size() { wc -c < "$1" | tr -d ' '; }
b64decode() { base64 -d 2>/dev/null || base64 -D; }
# never record credentials embedded in a remote URL (https://user:token@host/...)
strip_userinfo() { printf '%s' "$1" | sed -E 's#^([a-zA-Z][a-zA-Z0-9+.-]*://)[^/@]*@#\1#'; }
is_date() { printf '%s' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; }
date_add_days() {  # $1 YYYY-MM-DD  $2 signed integer days -> YYYY-MM-DD (GNU date or BSD date)
  local n="$2"; case "$n" in -*) ;; *) n="+$n";; esac
  date -u -d "$1 $2 days" +%Y-%m-%d 2>/dev/null || date -u -j -v"${n}d" -f %Y-%m-%d "$1" +%Y-%m-%d
}

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

runtime_kind() {
  if [ -n "${SBOMGATE_RUNTIME:-}" ]; then printf '%s' "$SBOMGATE_RUNTIME"
  elif [ -f /.dockerenv ] || grep -qs 'docker\|containerd' /proc/1/cgroup 2>/dev/null; then printf 'container'
  else printf 'native'; fi
}
host_os()   { case "$(uname -s)" in Darwin) echo macos;; Linux) echo linux;; MINGW*|MSYS*|CYGWIN*) echo windows;; *) uname -s;; esac; }
host_arch() { case "$(uname -m)" in x86_64|amd64) echo amd64;; arm64|aarch64) echo arm64;; *) uname -m;; esac; }

tool_versions_json() {
  need syft; need grype; need jq
  local syft_v grype_v trivy_v yq_v jq_v cosign_v
  syft_v="$(syft version -o json 2>/dev/null | jq -r .version)"
  grype_v="$(grype version -o json 2>/dev/null | jq -r .version)"
  if command -v trivy >/dev/null 2>&1; then trivy_v="$(trivy --version 2>/dev/null | sed -n 's/^Version: *//p' | head -1)"; else trivy_v="absent"; fi
  if command -v yq >/dev/null 2>&1; then yq_v="$(yq --version 2>/dev/null | sed 's/.*version v\{0,1\}//')"; else yq_v="absent"; fi
  jq_v="$(jq --version 2>/dev/null | sed 's/^jq-//')"
  if command -v cosign >/dev/null 2>&1; then cosign_v="$(cosign version --json 2>/dev/null | jq -r '.gitVersion // empty' 2>/dev/null | sed 's/^v//')"; [ -n "$cosign_v" ] || cosign_v="unknown"; else cosign_v="absent"; fi
  jq -n --arg t "$TOOLKIT_VERSION" --arg s "$syft_v" --arg g "$grype_v" --arg tr "$trivy_v" --arg y "$yq_v" --arg j "$jq_v" --arg c "$cosign_v" \
     --arg os "$(host_os)" --arg arch "$(host_arch)" --arg rt "$(runtime_kind)" \
     '{toolkit:$t, syft:$s, grype:$g, trivy:$tr, yq:$y, jq:$j, cosign:$c, platform:{os:$os, arch:$arch, runtime:$rt}}'
}

sev_rank() {  # CRITICAL=4 HIGH=3 MEDIUM=2 LOW=1 none=0
  case "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" in
    CRITICAL) echo 4;; HIGH) echo 3;; MEDIUM) echo 2;; LOW) echo 1;; NONE) echo 0;;
    *) die_policy "--fail-on must be one of CRITICAL|HIGH|MEDIUM|LOW|none (got '$1')";;
  esac
}

# ── allowlist → grype ignore config ──────────────────────────────────────────
# .sbom-cicd/allowlist.yaml:
#   version: 1
#   exemptions:
#     - vulnerability: CVE-2024-1234      (required)
#       package: name-or-empty            (optional; empty = any package)
#       reason: why this is acceptable    (required)
#       approved_by: Name <email>         (required)
#       approved_on: YYYY-MM-DD           (required)
#       expires: YYYY-MM-DD               (required; past date = policy error, exit 5)
render_allowlist() {  # $1 allowlist.yaml  $2 grype-config-out  $3 exemptions-json-out
  need yq
  local n i vuln pkg reason by on exp
  n="$(yq -r '.exemptions | length' "$1")"
  [ "$n" = "null" ] && n=0
  printf 'ignore:\n' > "$2"
  printf '[' > "$3"
  i=0
  while [ "$i" -lt "$n" ]; do
    vuln="$(yq -r ".exemptions[$i].vulnerability // \"\"" "$1")"
    pkg="$(yq -r ".exemptions[$i].package // \"\"" "$1")"
    reason="$(yq -r ".exemptions[$i].reason // \"\"" "$1")"
    by="$(yq -r ".exemptions[$i].approved_by // \"\"" "$1")"
    on="$(yq -r ".exemptions[$i].approved_on // \"\"" "$1")"
    exp="$(yq -r ".exemptions[$i].expires // \"\"" "$1")"
    [ -n "$vuln" ] && [ -n "$reason" ] && [ -n "$by" ] && [ -n "$on" ] && [ -n "$exp" ] \
      || die_policy "allowlist entry #$i is incomplete: vulnerability, reason, approved_by, approved_on, expires are all required"
    printf '%s' "$exp" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die_policy "allowlist entry #$i: expires must be YYYY-MM-DD"
    if [ "$exp" \< "$TODAY" ]; then die_policy "allowlist entry #$i ($vuln) EXPIRED on $exp — renew the approval or remove it"; fi
    printf '  - vulnerability: "%s"\n' "$vuln" >> "$2"
    [ -n "$pkg" ] && printf '    package:\n      name: "%s"\n' "$pkg" >> "$2"
    [ "$i" -gt 0 ] && printf ',' >> "$3"
    jq -n --arg v "$vuln" --arg p "$pkg" --arg r "$reason" --arg b "$by" --arg o "$on" --arg e "$exp" \
       '{vulnerability:$v, package:$p, reason:$r, approved_by:$b, approved_on:$o, expires:$e}' >> "$3"
    i=$((i + 1))
  done
  printf ']' >> "$3"
  log "allowlist: $n exemption(s) accepted from $1"
}

# ── artifacts[] ──────────────────────────────────────────────────────────────
ARTIFACT_GATE_FILES="gate/tools.json gate/exemptions.json gate/findings.grype.json gate/findings.trivy.json gate/grype-ignore.yaml"
artifacts_json() {  # $1 out dir -> JSON [{path, sha256, size}] sorted by path (POSIX, relative)
  local d="$1" rel f
  {
    ( cd "$d" && find sbom scan -type f 2>/dev/null || true )
    for f in $ARTIFACT_GATE_FILES; do [ -f "$d/$f" ] && printf '%s\n' "$f"; done
  } | LC_ALL=C sort -u | while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    printf '%s\t%s\t%s\n' "$rel" "$(sha256_of "$d/$rel")" "$(file_size "$d/$rel")"
  done | jq -R -s '[ split("\n")[] | select(length > 0) | split("\t") | {path:.[0], sha256:.[1], size:(.[2]|tonumber)} ] | sort_by(.path)'
}

# ── scan ─────────────────────────────────────────────────────────────────────
cmd_scan() {
  local SRC="" IMAGE_TAR="" IMAGE_REF="" OUT="" NAME="" LABEL="" FAIL_ON="${SBOMGATE_FAIL_ON:-HIGH}" ALLOW="" ONLY_FIXED=0 NO_TRIVY=0 GIT_FILTER=1 EXCL_ARGS=()
  local SOURCE_URL="" SOURCE_URL_SET=0 SOURCE_REF=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --source) SRC="$2"; shift 2;;      --image-tar) IMAGE_TAR="$2"; shift 2;;
      --image) IMAGE_REF="$2"; shift 2;; --out) OUT="$2"; shift 2;;
      --name) NAME="$2"; shift 2;;       --label) LABEL="$2"; shift 2;;
      --fail-on) FAIL_ON="$2"; shift 2;; --allowlist) ALLOW="$2"; shift 2;;
      --only-fixed) ONLY_FIXED=1; shift;; --no-trivy) NO_TRIVY=1; shift;;
      --exclude) EXCL_ARGS+=(--exclude "$2"); shift 2;; --no-git-filter) GIT_FILTER=0; shift;;
      --source-url) SOURCE_URL="$2"; SOURCE_URL_SET=1; shift 2;; --source-ref) SOURCE_REF="$2"; shift 2;;
      -h|--help) usage; exit 0;;
      *) die_usage "unknown argument: $1";;
    esac
  done
  [ -n "$SRC" ] || [ -n "$IMAGE_TAR" ] || [ -n "$IMAGE_REF" ] || die_usage "--source DIR (and/or --image-tar / --image) is required"
  need syft; need grype; need jq
  [ "$NO_TRIVY" = 1 ] || need trivy
  local rank; rank="$(sev_rank "$FAIL_ON")"

  if [ -n "$SRC" ]; then [ -d "$SRC" ] || die_usage "--source $SRC is not a directory"; SRC="$(cd "$SRC" && pwd)"; fi
  [ -n "$OUT" ] || OUT="${SRC:-.}/sbom-out"
  mkdir -p "$OUT/sbom" "$OUT/scan" "$OUT/gate"; OUT="$(cd "$OUT" && pwd)"
  [ -n "$NAME" ] || NAME="$(basename "${SRC:-${IMAGE_REF:-${IMAGE_TAR}}}" | sed 's/[^A-Za-z0-9._-]/_/g')"
  local GIT_SHA="" GIT_DIRTY=""
  if [ -n "$SRC" ] && command -v git >/dev/null 2>&1 && g -C "$SRC" rev-parse HEAD >/dev/null 2>&1; then
    GIT_SHA="$(g -C "$SRC" rev-parse HEAD)"
    [ -n "$(g -C "$SRC" status --porcelain 2>/dev/null)" ] && GIT_DIRTY="dirty"
  fi
  if [ "$SOURCE_URL_SET" = 0 ] && [ -n "$SRC" ] && command -v git >/dev/null 2>&1; then
    SOURCE_URL="$(g -C "$SRC" remote get-url origin 2>/dev/null || true)"
  fi
  SOURCE_URL="$(strip_userinfo "$SOURCE_URL")"
  [ -n "$LABEL" ] || LABEL="${GIT_SHA:+${GIT_SHA}}"; [ -n "$LABEL" ] || LABEL="unversioned"
  [ -n "$ALLOW" ] || { [ -n "$SRC" ] && [ -f "$SRC/.sbom-cicd/allowlist.yaml" ] && ALLOW="$SRC/.sbom-cicd/allowlist.yaml"; } || true

  exec > >(tee -a "$OUT/sbomgate.log") 2>&1
  log "sbom-cicd-toolkit $TOOLKIT_VERSION · $(host_os)/$(host_arch) · runtime=$(runtime_kind)"
  log "name=$NAME label=$LABEL fail_on=$FAIL_ON only_fixed=$ONLY_FIXED out=$OUT"
  tool_versions_json > "$OUT/gate/tools.json"
  log "tools: $(jq -c 'del(.platform)' "$OUT/gate/tools.json")"

  # allowlist
  local GRYPE_CFG="$OUT/gate/grype-ignore.yaml" EXEMPT="$OUT/gate/exemptions.json"
  if [ -n "$ALLOW" ]; then
    [ -f "$ALLOW" ] || die_usage "--allowlist $ALLOW not found"
    render_allowlist "$ALLOW" "$GRYPE_CFG" "$EXEMPT"
  else
    printf 'ignore: []\n' > "$GRYPE_CFG"; printf '[]' > "$EXEMPT"; log "allowlist: none"
  fi

  # A rerun into the same --out must never leave an older verdict or scan behind for a reader to mistake
  # for this run's (an unavailable scanner writes no scan file this time).
  rm -f "$OUT/gate.json" "$OUT/gate/gate.json" "$OUT"/gate/norm.*.json "$OUT"/gate/meta.grype.*.json \
        "$OUT"/scan/grype.*.json "$OUT"/scan/trivy.*.json "$OUT/gate/.unavailable.jsonl"
  local ERRD="$OUT/gate/stderr" UNAVF="$OUT/gate/.unavailable.jsonl" GRYPE_COMPLETE=1 rc line
  mkdir -p "$ERRD"; : > "$UNAVF"
  # run a tool with its stderr kept in a file (still echoed to the log), so a failure can be classified
  run_capture() { local e="$1"; shift; local r=0; "$@" 2>"$e" || r=$?; [ -s "$e" ] && cat "$e" >&2; return "$r"; }
  record_unavailable() {  # $1 scanner/step  $2 kind  $3 stderr file  $4 deciding line
    jq -cn --arg s "$1" --arg k "$2" --arg d "$4" --argjson e "$(net_endpoints "$3")" \
      '{scanner:$s, kind:$k, endpoints:$e, detail:$d}' >> "$UNAVF"
  }
  syft_or_die() {  # $1 label  $2 stderr file  $@ syft args
    local what="$1" e="$2" r=0 l; shift 2
    run_capture "$e" syft "$@" || r=$?
    [ "$r" = 0 ] && return 0
    if l="$(net_failure_line "$e")"; then die_unavailable "syft could not get the $what: $l"; fi
    die "syft exited $r on the $what (see messages above)"
  }

  # SBOMs
  local KINDS=""
  local SCAN_DIR="" SNAP_FILES=""
  if [ -n "$SRC" ]; then
    SCAN_DIR="$SRC"
    if [ "$GIT_FILTER" = 1 ] && [ -n "$GIT_SHA" ]; then
      # Snapshot = tracked + untracked-but-not-ignored files: exactly what a commit would contain,
      # including a builder's uncommitted work, minus caches/runtime dirs listed in .gitignore.
      SCAN_DIR="$OUT/.source-snapshot"; rm -rf "$SCAN_DIR"; mkdir -p "$SCAN_DIR"
      local f n=0
      while IFS= read -r -d '' f; do
        [ -f "$SRC/$f" ] || continue
        case "$f" in */*) mkdir -p "$SCAN_DIR/${f%/*}";; esac
        cp -p "$SRC/$f" "$SCAN_DIR/$f" 2>/dev/null || cp "$SRC/$f" "$SCAN_DIR/$f"
        n=$((n + 1))
      done < <(g -C "$SRC" ls-files -z --cached --others --exclude-standard)
      SNAP_FILES="$n"
      log "git filter: snapshot of $n tracked/untracked-not-ignored file(s) -> $SCAN_DIR"
    fi
    log "syft: source SBOM of $SRC (excludes: ${EXCL_ARGS[*]-none})"
    # --out inside the source: exclude it. An ARRAY, quoted: as an unquoted string the `**` was
    # glob-expanded by bash whenever the cwd was the source tree (sssf native mode), handing syft
    # several paths ("accepts at most 1 arg(s)") — broken since 1.0, fixed in 1.3.1.
    local SELF_EXCL=()
    case "$OUT" in "$SRC"/*) SELF_EXCL=(--exclude "./${OUT#"$SRC"/}/**");; esac
    syft_or_die "source tree" "$ERRD/syft.source.err" scan "dir:$(wpath "$SCAN_DIR")" -q --source-name "$NAME" --source-version "$LABEL" --exclude './.git/**' ${SELF_EXCL[@]+"${SELF_EXCL[@]}"} ${EXCL_ARGS[@]+"${EXCL_ARGS[@]}"} \
      -o "cyclonedx-json=$(wpath "$OUT/sbom/$NAME.source.cdx.json")" -o "spdx-json=$(wpath "$OUT/sbom/$NAME.source.spdx.json")"
    [ "$SCAN_DIR" = "$SRC" ] || rm -rf "$SCAN_DIR"
    KINDS="source"
  fi
  if [ -n "$IMAGE_TAR" ]; then
    [ -f "$IMAGE_TAR" ] || die_usage "--image-tar $IMAGE_TAR not found"
    log "syft: image SBOM of docker-archive:$IMAGE_TAR"
    syft_or_die "image tar" "$ERRD/syft.image.err" scan "docker-archive:$(wpath "$IMAGE_TAR")" -q --source-name "$NAME-image" --source-version "$LABEL" \
      -o "cyclonedx-json=$(wpath "$OUT/sbom/$NAME.image.cdx.json")" -o "spdx-json=$(wpath "$OUT/sbom/$NAME.image.spdx.json")"
    KINDS="$KINDS image"
  elif [ -n "$IMAGE_REF" ]; then
    log "syft: image SBOM of docker:$IMAGE_REF (needs the docker socket)"
    syft_or_die "image $IMAGE_REF" "$ERRD/syft.image.err" scan "docker:$IMAGE_REF" -q --source-name "$NAME-image" --source-version "$LABEL" \
      -o "cyclonedx-json=$(wpath "$OUT/sbom/$NAME.image.cdx.json")" -o "spdx-json=$(wpath "$OUT/sbom/$NAME.image.spdx.json")"
    KINDS="$KINDS image"
  fi

  # Scans. grype COUNTS (the gate verdict); trivy cross-checks. A scanner that cannot get its
  # vulnerability DB (network / registry / a stale DB that cannot be refreshed) is recorded as
  # unavailable instead of killing the run, so whatever DID run still decides what it can.
  local kind of="" sboms="[]"
  [ "$ONLY_FIXED" = 1 ] && of="--only-fixed"
  for kind in $KINDS; do
    local cdx="$OUT/sbom/$NAME.$kind.cdx.json" spdx="$OUT/sbom/$NAME.$kind.spdx.json"
    sboms="$(jq -c --arg k "$kind" --arg c "$cdx" --arg s "$spdx" \
      --argjson nc "$(jq '.components|length' "$cdx")" --argjson ns "$(jq '.packages|length' "$spdx")" \
      --arg cv "$(jq -r '.specVersion' "$cdx")" --arg sv "$(jq -r '.spdxVersion' "$spdx")" \
      '. + [{kind:$k, cyclonedx:{file:$c, spec:$cv, components:$nc}, spdx:{file:$s, spec:$sv, packages:$ns}}]' <<<"$sboms")"
    log "grype: $kind ($(jq '.components|length' "$cdx") components)"
    rc=0
    # shellcheck disable=SC2086
    run_capture "$ERRD/grype.$kind.err" grype "sbom:$(wpath "$cdx")" -o json --file "$(wpath "$OUT/scan/grype.$kind.json")" -c "$(wpath "$GRYPE_CFG")" $of || rc=$?
    if [ "$rc" != 0 ] || [ ! -s "$OUT/scan/grype.$kind.json" ]; then
      if line="$(net_failure_line "$ERRD/grype.$kind.err")"; then
        log "grype: $kind UNAVAILABLE (exit $rc) — $line"
        record_unavailable grype "$kind" "$ERRD/grype.$kind.err" "$line"
        rm -f "$OUT/scan/grype.$kind.json"; printf '[]' > "$OUT/gate/norm.grype.$kind.json"
        printf '{"ignored":0,"db":{}}' > "$OUT/gate/meta.grype.$kind.json"; GRYPE_COMPLETE=0
      elif [ "$rc" != 0 ]; then
        die "grype exited $rc on $kind SBOM (match failure — see messages above; check disk space)"
      else
        die "grype produced no output for $kind SBOM ($OUT/scan/grype.$kind.json is empty)"
      fi
    else
      jq --arg k "$kind" '[ .matches[] | {id:.vulnerability.id, severity:(.vulnerability.severity|ascii_upcase),
          package:.artifact.name, version:.artifact.version, type:.artifact.type,
          fixed_in:((.vulnerability.fix.versions // [])|join(", ")), fix_state:(.vulnerability.fix.state // "unknown"),
          kind:$k, scanner:"grype"} ] | unique_by(.id,.package,.version)' "$OUT/scan/grype.$kind.json" > "$OUT/gate/norm.grype.$kind.json"
      jq '{ignored:(.ignoredMatches // [] | length), db:(.descriptor.db // {} | {built: (.built // .status.built // null), schema: (.schemaVersion // .status.schemaVersion // null)})}' \
        "$OUT/scan/grype.$kind.json" > "$OUT/gate/meta.grype.$kind.json"
    fi
    if [ "$NO_TRIVY" = 0 ]; then
      log "trivy: $kind"
      rc=0
      run_capture "$ERRD/trivy.$kind.err" trivy sbom "$(wpath "$cdx")" -q --format json --output "$(wpath "$OUT/scan/trivy.$kind.json")" --scanners vuln || rc=$?
      if [ "$rc" != 0 ] || [ ! -s "$OUT/scan/trivy.$kind.json" ]; then
        if line="$(net_failure_line "$ERRD/trivy.$kind.err")"; then
          log "trivy: $kind UNAVAILABLE (exit $rc) — $line"
          record_unavailable trivy "$kind" "$ERRD/trivy.$kind.err" "$line"
          rm -f "$OUT/scan/trivy.$kind.json"; printf '[]' > "$OUT/gate/norm.trivy.$kind.json"
        elif [ "$rc" != 0 ]; then
          die "trivy exited $rc on $kind SBOM (scan failure — see messages above)"
        else
          die "trivy produced no output for $kind SBOM"
        fi
      else
        jq --arg k "$kind" '[ (.Results // [])[] | (.Vulnerabilities // [])[] | {id:.VulnerabilityID, severity:(.Severity|ascii_upcase),
            package:.PkgName, version:.InstalledVersion, fixed_in:(.FixedVersion // ""), kind:$k, scanner:"trivy"} ] | unique_by(.id,.package,.version)' \
            "$OUT/scan/trivy.$kind.json" > "$OUT/gate/norm.trivy.$kind.json"
      fi
    else
      printf '[]' > "$OUT/gate/norm.trivy.$kind.json"
    fi
  done

  # Gate. Order of certainty: CVEs really found (2) > something could not be got (3) > PASS (0).
  local RESULT counted counted_json exit_code ARTS UNAV n_unav
  jq -s 'add // []' "$OUT"/gate/norm.grype.*.json > "$OUT/gate/findings.grype.json"
  jq -s 'add // []' "$OUT"/gate/norm.trivy.*.json > "$OUT/gate/findings.trivy.json"
  jq -s '{ignored:(map(.ignored)|add // 0), db:(map(select(.db != {}))[0].db // {})}' "$OUT"/gate/meta.grype.*.json > "$OUT/gate/meta.grype.json"
  UNAV="$(jq -s '.' "$UNAVF")"; rm -f "$UNAVF"; n_unav="$(jq 'length' <<<"$UNAV")"
  counted="$(jq --argjson r "$rank" '
      def rk: if .=="CRITICAL" then 4 elif .=="HIGH" then 3 elif .=="MEDIUM" then 2 elif .=="LOW" then 1 else 0 end;
      if $r == 0 then 0 else [ .[] | select((.severity|rk) >= $r) ] | length end' "$OUT/gate/findings.grype.json")"
  if [ "$counted" -gt 0 ]; then RESULT=FAIL; exit_code="$EX_FINDINGS"
  elif [ "$n_unav" -gt 0 ]; then RESULT=UNAVAILABLE; exit_code="$EX_UNAVAILABLE"
  else RESULT=PASS; exit_code="$EX_PASS"; fi
  # a count from an incomplete grype run is only a number when it found something
  counted_json="$counted"; [ "$GRYPE_COMPLETE" = 1 ] || [ "$counted" -gt 0 ] || counted_json=null
  # artifacts[] (schema 2, RQ9): hashed immediately before gate.json is written; gate.json itself,
  # gate/gate.json, summary.md and sbomgate.log are written after / streamed and are NOT listed.
  ARTS="$OUT/gate/.artifacts.json"
  artifacts_json "$OUT" > "$ARTS"

  jq -n --arg result "$RESULT" --argjson counted "$counted_json" --arg fail_on "$(printf '%s' "$FAIL_ON" | tr '[:lower:]' '[:upper:]')" \
     --argjson only_fixed "$([ "$ONLY_FIXED" = 1 ] && echo true || echo false)" \
     --arg allow "${ALLOW:-}" --slurpfile exemptions "$EXEMPT" --slurpfile tools "$OUT/gate/tools.json" \
     --arg now "$NOW" --arg name "$NAME" --arg label "$LABEL" --arg src "${SRC:-}" --arg tar "${IMAGE_TAR:-}" --arg ref "${IMAGE_REF:-}" \
     --arg sha "$GIT_SHA" --arg dirty "$GIT_DIRTY" --argjson sboms "$sboms" --argjson exit_code "$exit_code" \
     --arg gitfilter "${SNAP_FILES:-off}" --arg excludes "${EXCL_ARGS[*]-}" --argjson unav "$UNAV" \
     --slurpfile g "$OUT/gate/findings.grype.json" --slurpfile t "$OUT/gate/findings.trivy.json" --slurpfile gm "$OUT/gate/meta.grype.json" \
     --arg image_digest "${SBOMGATE_IMAGE_DIGEST:-}" --arg src_url "$SOURCE_URL" --arg src_ref "$SOURCE_REF" --slurpfile arts "$ARTS" '
     def counts: reduce .[] as $f ({CRITICAL:0,HIGH:0,MEDIUM:0,LOW:0,NEGLIGIBLE:0,UNKNOWN:0}; .[$f.severity] += 1);
     def by_kind: group_by(.kind) | map({key:.[0].kind, value:(counts)}) | from_entries;
     {schema:2, result:$result, exit_code:$exit_code, counted_at_or_above_threshold:$counted, timestamp:$now,
      toolkit:{version:$tools[0].toolkit, image_digest:$image_digest},
      platform:$tools[0].platform, tools:($tools[0]|del(.platform,.toolkit)),
      target:{name:$name, label:$label, source:$src, image_tar:$tar, image_ref:$ref, git_sha:$sha, git_dirty:($dirty=="dirty"), git_filter_files:$gitfilter, excludes:$excludes},
      policy:{fail_on:$fail_on, only_fixed:$only_fixed, allowlist_file:$allow, exemptions:$exemptions[0], grype_ignored_matches:$gm[0].ignored},
      sbom:$sboms,
      grype:{db:$gm[0].db, total:($g[0]|counts), by_kind:($g[0]|by_kind)},
      trivy:{total:($t[0]|counts), by_kind:($t[0]|by_kind)},
      findings_critical_high:[ $g[0][] | select(.severity=="CRITICAL" or .severity=="HIGH") ],
      unavailable:$unav,
      source:{remote_url:$src_url, git_sha:$sha, git_ref:$src_ref},
      artifacts:$arts[0] }' > "$OUT/gate/gate.json"
  rm -f "$ARTS"
  cp "$OUT/gate/gate.json" "$OUT/gate.json"

  # Human summary
  {
    printf '# sbomgate %s — %s\n\n' "$TOOLKIT_VERSION" "$NAME"
    printf -- '- result: **%s** (fail_on=%s, counted=%s, exit=%s)\n' "$RESULT" "$FAIL_ON" "$counted_json" "$exit_code"
    printf -- '- label: %s · git: %s%s · %s\n' "$LABEL" "${GIT_SHA:-n/a}" "${GIT_DIRTY:+ ($GIT_DIRTY)}" "$NOW"
    printf -- '- platform: %s · tools: %s\n' "$(jq -c .platform "$OUT/gate/tools.json")" "$(jq -c 'del(.platform,.toolkit)' "$OUT/gate/tools.json")"
    printf '\n| SBOM | CycloneDX | components | SPDX | packages |\n|---|---|---|---|---|\n'
    jq -r '.[] | "| \(.kind) | \(.cyclonedx.spec) | \(.cyclonedx.components) | \(.spdx.spec) | \(.spdx.packages) |"' <<<"$sboms"
    printf '\n| scanner | CRITICAL | HIGH | MEDIUM | LOW | NEGLIGIBLE | UNKNOWN |\n|---|---|---|---|---|---|---|\n'
    jq -r '"| grype | \(.grype.total.CRITICAL) | \(.grype.total.HIGH) | \(.grype.total.MEDIUM) | \(.grype.total.LOW) | \(.grype.total.NEGLIGIBLE) | \(.grype.total.UNKNOWN) |",
           "| trivy | \(.trivy.total.CRITICAL) | \(.trivy.total.HIGH) | \(.trivy.total.MEDIUM) | \(.trivy.total.LOW) | \(.trivy.total.NEGLIGIBLE) | \(.trivy.total.UNKNOWN) |"' "$OUT/gate.json"
    printf '\n- exemptions applied: %s (grype ignored %s match(es))\n' "$(jq '.policy.exemptions|length' "$OUT/gate.json")" "$(jq '.policy.grype_ignored_matches' "$OUT/gate.json")"
    if [ "$n_unav" -gt 0 ]; then
      printf '\n## UNAVAILABLE (not scanned — not a CVE verdict, not a signature problem)\n\n| scanner | kind | endpoints | detail |\n|---|---|---|---|\n'
      jq -r '.unavailable[] | "| \(.scanner) | \(.kind) | \(.endpoints | join(", ")) | \(.detail | gsub("\\|"; "/")) |"' "$OUT/gate.json"
    fi
    if [ "$(jq '.findings_critical_high|length' "$OUT/gate.json")" -gt 0 ]; then
      printf '\n## CRITICAL / HIGH (grype)\n\n| severity | id | package | version | fixed in | kind |\n|---|---|---|---|---|---|\n'
      jq -r '.findings_critical_high | sort_by(.severity,.id)[] | "| \(.severity) | \(.id) | \(.package) | \(.version) | \(.fixed_in) | \(.kind) |"' "$OUT/gate.json"
    fi
  } > "$OUT/summary.md"
  cat "$OUT/summary.md" >&2
  case "$RESULT" in
    FAIL) if [ "$n_unav" -gt 0 ]; then line=" (also unavailable, not scanned: $(jq -r '[.[].scanner] | unique | join(", ")' <<<"$UNAV"))"; else line=""; fi
          log "GATE FAIL: $counted finding(s) at or above $FAIL_ON — see $OUT/gate.json$line";;
    UNAVAILABLE) log "GATE UNAVAILABLE (exit $EX_UNAVAILABLE): $(jq -r '[.[] | "\(.scanner)/\(.kind)"] | join(", ")' <<<"$UNAV") could not get an external resource ($(jq -r '[.[].endpoints[]] | unique | join(", ") | if . == "" then "endpoint not named" else . end' <<<"$UNAV")) — $(if [ "$GRYPE_COMPLETE" = 1 ]; then printf 'grype found nothing at or above %s, but the run is incomplete' "$FAIL_ON"; else printf 'grype did not run: there is NO CVE verdict'; fi); not a signature problem; re-run when it is reachable";;
    *) log "GATE PASS: no finding at or above $FAIL_ON";;
  esac
  exit "$exit_code"
}

# ── trusted keys (RQ3) ───────────────────────────────────────────────────────
# A key is USABLE at date T iff status == active AND valid_from <= T <= valid_until.
resolve_trusted_keys() {  # $1 explicit --trusted-keys (may be empty) -> path on stdout
  if [ -n "$1" ]; then [ -f "$1" ] || die_policy "--trusted-keys $1 not found"; printf '%s' "$1"; return; fi
  if [ -n "${SBOMGATE_TRUSTED_KEYS:-}" ]; then [ -f "$SBOMGATE_TRUSTED_KEYS" ] || die_policy "SBOMGATE_TRUSTED_KEYS=$SBOMGATE_TRUSTED_KEYS not found"; printf '%s' "$SBOMGATE_TRUSTED_KEYS"; return; fi
  if [ -f "$SBOMGATE_HOME/trusted-keys.yaml" ]; then printf '%s' "$SBOMGATE_HOME/trusted-keys.yaml"; return; fi
  if [ -f "$SBOMGATE_HOME/policy/trusted-keys.yaml" ]; then printf '%s' "$SBOMGATE_HOME/policy/trusted-keys.yaml"; return; fi
  die_policy "no trusted-keys.yaml (tried --trusted-keys, \$SBOMGATE_TRUSTED_KEYS, $SBOMGATE_HOME/trusted-keys.yaml, $SBOMGATE_HOME/policy/trusted-keys.yaml)"
}
pem_fingerprint() {  # PEM public key on stdin -> hex sha256 of the DER SubjectPublicKeyInfo ("" if no PEM)
  local b64
  b64="$(sed -n '/-----BEGIN PUBLIC KEY-----/,/-----END PUBLIC KEY-----/p' | grep -v -- '-----' | tr -d ' \t\r\n')"
  [ -n "$b64" ] || return 0
  printf '%s' "$b64" | b64decode | sha256_stdin
}
hint_to_hex() { printf '%s' "$1" | b64decode | od -An -v -tx1 | tr -d ' \n'; }
# load_trusted_keys FILE DIR -> writes DIR/keys.json (normalized) and DIR/<n>.pem; dies on a malformed file
load_trusted_keys() {
  local f="$1" d="$2" n i pem fp_calc fp_decl err
  need yq; need jq
  yq -o=json '.' "$f" > "$d/raw.json" 2>"$d/yq.err" || die_policy "trusted keys $f: not valid YAML ($(head -1 "$d/yq.err"))"
  [ "$(jq -r '.version // empty' "$d/raw.json")" = "1" ] || die_policy "trusted keys $f: version must be 1"
  jq -e '(.keys // []) | type == "array"' "$d/raw.json" >/dev/null || die_policy "trusted keys $f: keys must be a list"
  n="$(jq '(.keys // []) | length' "$d/raw.json")"
  printf '[' > "$d/keys.json"
  i=0
  while [ "$i" -lt "$n" ]; do
    pem="$d/$i.pem"
    jq -r ".keys[$i].public_key // \"\"" "$d/raw.json" > "$pem"
    fp_calc="$(pem_fingerprint < "$pem")"
    fp_decl="$(jq -r ".keys[$i].fingerprint // \"\"" "$d/raw.json" | sed 's/^sha256://' | tr '[:upper:]' '[:lower:]')"
    err=""
    if [ -z "$fp_calc" ]; then err="public_key is not a PEM public key"
    elif [ "$fp_calc" != "$fp_decl" ]; then err="fingerprint sha256:$fp_decl does not match public_key (sha256:$fp_calc)"; fi
    [ "$i" -gt 0 ] && printf ',' >> "$d/keys.json"
    jq -c --argjson i "$i" --arg fp "$fp_calc" --arg pem "$pem" --arg err "$err" '
      .keys[$i] as $k
      | {id:($k.id // "" | tostring), purpose:($k.purpose // "" | tostring), status:($k.status // "" | tostring),
         fingerprint_hex:$fp, valid_from:($k.valid_from // "" | tostring), valid_until:($k.valid_until // "" | tostring),
         revoked_on:($k.revoked_on // "" | tostring), pem:$pem, entry_error:$err}
      | if .entry_error == "" and .id == "" then .entry_error = "id missing" else . end
      | if .entry_error == "" and ((.valid_from|test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))|not) then .entry_error = "valid_from must be YYYY-MM-DD" else . end
      | if .entry_error == "" and ((.valid_until|test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))|not) then .entry_error = "valid_until (required) must be YYYY-MM-DD" else . end
      | if .entry_error == "" and (.status != "active" and .status != "revoked") then .entry_error = "status must be active|revoked" else . end
      ' "$d/raw.json" >> "$d/keys.json"
    i=$((i + 1))
  done
  printf ']' >> "$d/keys.json"
  jq -r '.[] | select(.entry_error != "") | "trusted key #\(.id // "?"): ignored — \(.entry_error)"' "$d/keys.json" | while IFS= read -r l; do log "WARN $l"; done
}
# key state at date $2 for key JSON object on stdin: usable | key-revoked | key-expired | key-not-yet-valid | key-invalid-entry
# shellcheck disable=SC2016  # jq program, $at is a jq variable
KEY_STATE_JQ='def kstate($at): if .entry_error != "" then "key-invalid-entry" elif .status == "revoked" then "key-revoked"
  elif $at < .valid_from then "key-not-yet-valid" elif $at > .valid_until then "key-expired" else "usable" end;'

# ── verify-release (RQ1, RQ10) ───────────────────────────────────────────────
cmd_verify_release() {
  local DIR="" EXPECT="" TK="" AT="$TODAY" ALLOW_FAIL=0 SKIP_SIG=0 JSON=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --bundle-dir) DIR="$2"; shift 2;; --expect-sha) EXPECT="$2"; shift 2;;
      --trusted-keys) TK="$2"; shift 2;; --at) AT="$2"; shift 2;;
      --allow-fail-result) ALLOW_FAIL=1; shift;; --skip-signature) SKIP_SIG=1; shift;;
      --json) JSON=1; shift;; -h|--help) usage; exit 0;;
      *) die_usage "unknown argument: $1";;
    esac
  done
  [ -n "$DIR" ] || die_usage "--bundle-dir DIR is required"
  [ -d "$DIR" ] || die_usage "--bundle-dir $DIR is not a directory"
  is_date "$AT" || die_usage "--at must be YYYY-MM-DD (got '$AT')"
  need jq
  DIR="$(cd "$DIR" && pwd)"
  local W; W="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$W'" EXIT
  : > "$W/checks.jsonl"; : > "$W/bundles.jsonl"; : > "$W/verified"
  local FAILED=0 FAILED_TRUST=0
  chk() {  # $1 PASS|FAIL|SKIP|WARN  $2 name  $3 detail
    printf '%-4s %s: %s\n' "$1" "$2" "$3" >&2
    jq -cn --arg s "$1" --arg n "$2" --arg d "$3" '{name:$n, status:$s, detail:$d}' >> "$W/checks.jsonl"
    # a failed gate-result alone is a signed FAIL verdict (exit 2); any other failed check means the
    # evidence itself cannot be trusted (exit 4)
    if [ "$1" = FAIL ]; then FAILED=1; [ "$2" = gate-result ] || FAILED_TRUST=1; fi
    return 0
  }
  finish() {
    local result=PASS; [ "$FAILED" = 0 ] || result=FAIL
    printf '%s verify-release: %s (at=%s)\n' "$result" "$DIR" "$AT" >&2
    if [ "$JSON" = 1 ]; then
      jq -n --arg r "$result" --arg dir "$DIR" --arg at "$AT" --slurpfile c "$W/checks.jsonl" --slurpfile b "$W/bundles.jsonl" \
        --arg v "$(sort -u "$W/verified" | tr '\n' ' ')" \
        '{result:$r, bundle_dir:$dir, at:$at, checks:$c, bundles:$b, key_ids_verified:($v | split(" ") | map(select(length > 0)))}'
    fi
    [ "$result" = PASS ] && exit "$EX_PASS"
    [ "$FAILED_TRUST" = 1 ] && exit "$EX_UNTRUSTED"
    exit "$EX_FINDINGS"
  }
  printf '[verify-release] %s · sbom-cicd-toolkit %s · at %s\n' "$DIR" "$TOOLKIT_VERSION" "$AT" >&2

  # (1) gate.json parses, schema >= 2
  local G="$DIR/gate.json" schema
  if [ ! -f "$G" ]; then chk FAIL schema "gate.json missing in $DIR"; finish; fi
  if ! jq -e 'type == "object"' "$G" >/dev/null 2>&1; then chk FAIL schema "gate.json is not valid JSON"; finish; fi
  schema="$(jq -r '.schema // 0' "$G")"
  case "$schema" in ''|*[!0-9]*) schema=0;; esac
  if [ "$schema" -lt 2 ]; then chk FAIL schema "gate.json schema $schema < 2 (no artifacts[]/source binding; rescan with toolkit >= 1.2.0)"; finish; fi
  chk PASS schema "gate.json schema $schema"

  # (2) artifacts[]: every entry exists, sha256 + size match
  local n bad=0 i path want_sha want_size got_sha got_size
  n="$(jq '(.artifacts // []) | length' "$G")"
  if [ "$n" -eq 0 ]; then chk FAIL artifacts "artifacts[] is empty"; bad=1; fi
  jq -r '(.artifacts // [])[] | [(.path|tostring), (.sha256|tostring), (.size|tostring)] | @tsv' "$G" > "$W/arts.tsv"
  while IFS='	' read -r path want_sha want_size; do
    case "/$path/" in */../*|*/./*|//*) chk FAIL artifact-path "$path: unsafe path (absolute or contains . / ..)"; bad=1; continue;; esac
    case "$path" in /*|*\\*) chk FAIL artifact-path "$path: unsafe path"; bad=1; continue;; esac
    if [ ! -f "$DIR/$path" ]; then chk FAIL artifact-missing "$path"; bad=1; continue; fi
    got_sha="$(sha256_of "$DIR/$path")"; got_size="$(file_size "$DIR/$path")"
    if [ "$got_sha" != "$want_sha" ]; then chk FAIL artifact-hash "$path sha256 $got_sha != $want_sha"; bad=1; fi
    if [ "$got_size" != "$want_size" ]; then chk FAIL artifact-size "$path size $got_size != $want_size"; bad=1; fi
  done < "$W/arts.tsv"
  [ "$bad" = 0 ] && chk PASS artifacts "$n file(s): sha256 + size match"
  # files present under sbom/ scan/ but not bound by artifacts[] are reported, not fatal
  ( cd "$DIR" && find sbom scan -type f 2>/dev/null || true ) | LC_ALL=C sort > "$W/present"
  jq -r '(.artifacts // [])[].path' "$G" | LC_ALL=C sort > "$W/listed"
  i="$(comm -23 "$W/present" "$W/listed" | tr '\n' ' ')"
  [ -z "$i" ] || chk WARN artifacts-unlisted "not covered by the signature: $i"

  # (3) git sha binding
  local gsha
  gsha="$(jq -r '.source.git_sha // .target.git_sha // ""' "$G")"
  if [ -n "$EXPECT" ]; then
    EXPECT="$(printf '%s' "$EXPECT" | tr '[:upper:]' '[:lower:]')"
    if [ "${#EXPECT}" -lt 7 ]; then chk FAIL git-sha "--expect-sha needs at least 7 hex chars (got '$EXPECT')"
    elif [ -z "$gsha" ]; then chk FAIL git-sha "gate.json has no source.git_sha"
    else
      case "$gsha" in "$EXPECT"*) chk PASS git-sha "source.git_sha $gsha matches $EXPECT";;
        *) chk FAIL git-sha "source.git_sha $gsha != expected $EXPECT";; esac
    fi
  else
    chk SKIP git-sha "no --expect-sha given (gate.json source.git_sha=${gsha:-none})"
  fi

  # (4) signatures: ANY bundle verified by a usable trusted key -> PASS
  if [ "$SKIP_SIG" = 1 ]; then
    chk SKIP signature "--skip-signature (pre-sign self check)"
  else
    need cosign
    local TKF b hint hex kid state det fname ok_any=0 nb=0
    TKF="$(resolve_trusted_keys "$TK")"
    load_trusted_keys "$TKF" "$W"
    for b in "$DIR"/gate.json.*.sigstore.json; do
      [ -f "$b" ] || continue
      nb=$((nb + 1)); fname="$(basename "$b")"; kid=""; state=""; det=""
      if ! jq -e 'type == "object"' "$b" >/dev/null 2>&1; then
        state="bundle-invalid"; det="not valid JSON"
      else
        hint="$(jq -r '.verificationMaterial.publicKey.hint // ""' "$b")"
        if [ -n "$hint" ]; then
          hex="$(hint_to_hex "$hint")"
          kid="$(jq -r --arg h "$hex" '[.[] | select(.fingerprint_hex == $h)][0].id // ""' "$W/keys.json")"
          if [ -z "$kid" ]; then
            state="key-unknown"; det="signing key sha256:$hex is not in $TKF"
          else
            state="$(jq -r --arg h "$hex" --arg at "$AT" "$KEY_STATE_JQ"' [.[] | select(.fingerprint_hex == $h)][0] | kstate($at)' "$W/keys.json")"
            if [ "$state" = usable ]; then
              if cosign verify-blob --key "$(jq -r --arg h "$hex" '[.[] | select(.fingerprint_hex == $h)][0].pem' "$W/keys.json")" \
                   --bundle "$b" --insecure-ignore-tlog "$G" >"$W/cosign.out" 2>"$W/cosign.err"; then
                state="verified"
              else
                state="signature-invalid"; det="$(grep -v '^WARNING' "$W/cosign.err" | tail -1)"
              fi
            else
              det="$(jq -r --arg h "$hex" '[.[] | select(.fingerprint_hex == $h)][0] | "status=\(.status) valid \(.valid_from)..\(.valid_until)\(if .entry_error != "" then " (" + .entry_error + ")" else "" end)"' "$W/keys.json")"
            fi
          fi
        else
          # no hint: try every usable key
          state="signature-invalid"; det="bundle has no public key hint; no usable trusted key verified it"
          local k pem
          for k in $(jq -r --arg at "$AT" "$KEY_STATE_JQ"' to_entries[] | select(.value | kstate($at) == "usable") | .key' "$W/keys.json"); do
            pem="$(jq -r ".[$k].pem" "$W/keys.json")"
            if cosign verify-blob --key "$pem" --bundle "$b" --insecure-ignore-tlog "$G" >/dev/null 2>&1; then
              kid="$(jq -r ".[$k].id" "$W/keys.json")"; state="verified"; det=""; break
            fi
          done
        fi
      fi
      if [ "$state" = verified ]; then
        ok_any=1; printf '%s\n' "$kid" >> "$W/verified"
        chk PASS "bundle $fname" "key=$kid verified"
      else
        chk INFO "bundle $fname" "key=${kid:-?} $state${det:+ — $det}"
      fi
      jq -cn --arg f "$fname" --arg k "$kid" --arg s "$state" --arg d "$det" '{file:$f, key_id:$k, status:$s, detail:$d}' >> "$W/bundles.jsonl"
    done
    if [ "$nb" = 0 ]; then chk FAIL signature "no gate.json.<keyid>.sigstore.json bundle in $DIR"
    elif [ "$ok_any" = 1 ]; then chk PASS signature "verified by $(sort -u "$W/verified" | tr '\n' ' ')(trusted keys: $TKF)"
    else chk FAIL signature "none of $nb bundle(s) verified with a usable trusted key: $(jq -r -s 'map("\(.file)=\(.status)") | join(", ")' "$W/bundles.jsonl")"; fi
  fi

  # (5) gate result
  local res
  res="$(jq -r '.result // ""' "$G")"
  if [ "$res" = PASS ]; then chk PASS gate-result "gate.json result PASS"
  elif [ "$ALLOW_FAIL" = 1 ]; then chk WARN gate-result "gate.json result $res accepted by --allow-fail-result (signed evidence of a FAILED gate)"
  else chk FAIL gate-result "gate.json result is '$res' (a signed FAIL is evidence of a failed gate, not a releasable build; --allow-fail-result to accept)"; fi
  finish
}

# ── verify-toolkit (RQ1, RQ2) ────────────────────────────────────────────────
# cosign 3.x with a key and no transparency log (measured against registry:2, see docs):
#   cosign verify --key PEM --insecure-ignore-tlog REF@sha256:...
#   cosign verify-attestation --key PEM --insecure-ignore-tlog --type cyclonedx REF@sha256:...
cmd_verify_toolkit() {
  local IMG="" TK="" AT="$TODAY" JSON=0 ATT=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --image) IMG="$2"; shift 2;; --trusted-keys) TK="$2"; shift 2;; --at) AT="$2"; shift 2;;
      --attestation) ATT=1; shift;; --json) JSON=1; shift;; -h|--help) usage; exit 0;;
      *) die_usage "unknown argument: $1";;
    esac
  done
  [ -n "$IMG" ] || die_usage "--image REF@sha256:<digest> is required"
  printf '%s' "$IMG" | grep -Eq '@sha256:[0-9a-f]{64}$' || die_usage "--image $IMG: pin the digest (REF@sha256:<64 hex>); a tag-only reference is not verifiable"
  is_date "$AT" || die_usage "--at must be YYYY-MM-DD (got '$AT')"
  need jq; need cosign
  local W; W="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$W'" EXIT
  local TKF k id pem sig_ok="" att_ok="" tried="" net=""
  TKF="$(resolve_trusted_keys "$TK")"
  load_trusted_keys "$TKF" "$W"
  for k in $(jq -r --arg at "$AT" "$KEY_STATE_JQ"' to_entries[] | select(.value | kstate($at) == "usable") | .key' "$W/keys.json"); do
    id="$(jq -r ".[$k].id" "$W/keys.json")"; pem="$(jq -r ".[$k].pem" "$W/keys.json")"; tried="$tried $id"
    if cosign verify --key "$pem" --insecure-ignore-tlog "$IMG" >"$W/v.out" 2>"$W/v.err"; then
      sig_ok="$id"; log "PASS image signature: $IMG verified by key $id"
      if [ "$ATT" = 1 ]; then
        if cosign verify-attestation --key "$pem" --insecure-ignore-tlog --type cyclonedx "$IMG" >/dev/null 2>"$W/a.err"; then
          att_ok="$id"; log "PASS cyclonedx attestation verified by key $id"
        else
          log "FAIL cyclonedx attestation with key $id: $(grep -v '^WARNING' "$W/a.err" | tail -1)"
          [ -n "$net" ] || net="$(net_failure_line "$W/a.err" || true)"
        fi
      fi
      break
    else
      log "key $id: $(grep -v '^WARNING' "$W/v.err" | tail -1)"
      # the registry (signature referrer) could not be read: that is not a verdict on the signature
      [ -n "$net" ] || net="$(net_failure_line "$W/v.err" || true)"
    fi
  done
  local result=PASS
  [ -n "$sig_ok" ] || result=FAIL
  [ "$ATT" = 1 ] && [ -z "$att_ok" ] && result=FAIL
  [ -n "$tried" ] || log "no usable trusted key at $AT in $TKF"
  printf '%s verify-toolkit: %s%s\n' "$result" "$IMG" "${sig_ok:+ (key $sig_ok)}" >&2
  if [ "$JSON" = 1 ]; then
    jq -n --arg r "$result" --arg i "$IMG" --arg k "$sig_ok" --arg a "$att_ok" --argjson att "$ATT" --arg tk "$TKF" --arg at "$AT" \
      '{result:$r, image:$i, key_id:$k, attestation:(if $att == 1 then {checked:true, key_id:$a} else {checked:false} end), trusted_keys:$tk, at:$at}'
  fi
  [ "$result" = PASS ] && return "$EX_PASS"
  if [ -n "$net" ]; then
    printf '[sbomgate] ERROR [unavailable]: verify-toolkit could not read the signature from the registry — NOT a signature mismatch: %s\n' "$net" >&2
    exit "$EX_UNAVAILABLE"
  fi
  if [ -n "$tried" ]; then
    printf '[sbomgate] ERROR [untrusted]: no usable trusted key (tried:%s) verifies %s\n' "$tried" "$IMG" >&2
  else
    printf '[sbomgate] ERROR [untrusted]: no usable trusted key at %s in %s\n' "$AT" "$TKF" >&2
  fi
  exit "$EX_UNTRUSTED"
}

# ── check-tools (RQ11) ───────────────────────────────────────────────────────
lock_os() { case "$(host_os)" in macos) echo darwin;; *) host_os;; esac; }
cmd_check_tools() {
  local LOCK="$SBOMGATE_HOME/tools.lock" JSON=0
  while [ $# -gt 0 ]; do
    case "$1" in --lock) LOCK="$2"; shift 2;; --json) JSON=1; shift;; -h|--help) usage; exit 0;; *) die_usage "unknown argument: $1";; esac
  done
  [ -f "$LOCK" ] || die_usage "tools.lock not found: $LOCK"
  local os arch t T ver want p got status all=ok rows="" mismatch=0
  os="$(lock_os)"; arch="$(host_arch)"
  for t in syft grype trivy yq jq cosign; do
    T="$(printf '%s' "$t" | tr '[:lower:]' '[:upper:]')"
    ver="$(sed -n "s/^${T}_VERSION=//p" "$LOCK" | head -1)"
    want="$(sed -n "s/^${T}_BIN_SHA256_${os}_${arch}=//p" "$LOCK" | head -1)"
    p="$(command -v "$t" 2>/dev/null || true)"
    [ -n "$p" ] && [ ! -f "$p" ] && [ -f "$p.exe" ] && p="$p.exe"
    if [ -z "$p" ] || [ ! -f "$p" ]; then status=missing; got="-"
    else
      got="$(sha256_of "$p")"
      if [ -n "$want" ] && [ "$got" = "$want" ]; then status=ok; else status=MISMATCH; fi
    fi
    [ "$status" = ok ] || all=fail
    [ "$status" = MISMATCH ] && mismatch=1
    [ -z "$want" ] && printf '[sbomgate] no %s_BIN_SHA256_%s_%s in %s\n' "$T" "$os" "$arch" "$LOCK" >&2
    [ "$status" = MISMATCH ] && [ -n "$want" ] && printf '[sbomgate] %s: %s sha256 %s, tools.lock wants %s\n' "$t" "$p" "$got" "$want" >&2
    if [ "$JSON" = 1 ]; then printf '%s %s %s %s\n' "$status" "$t" "${ver:-?}" "$got" >&2; else printf '%s %s %s %s\n' "$status" "$t" "${ver:-?}" "$got"; fi
    rows="$rows$(jq -cn --arg s "$status" --arg t "$t" --arg v "$ver" --arg g "$got" --arg w "$want" --arg p "$p" '{tool:$t, status:$s, version:$v, sha256:$g, expected:$w, path:$p}')
"
  done
  if [ "$JSON" = 1 ]; then
    printf '%s' "$rows" | jq -s --arg r "$all" --arg os "$os" --arg arch "$arch" --arg lock "$LOCK" '{result:$r, os:$os, arch:$arch, lock:$lock, tools:.}'
  fi
  [ "$all" = ok ] && return "$EX_PASS"
  # a binary that is present and different from tools.lock is not the toolkit (4); one that is
  # simply missing is a broken install (1)
  [ "$mismatch" = 1 ] && exit "$EX_UNTRUSTED"
  exit "$EX_ERROR"
}

# ── key-entry / key-status ───────────────────────────────────────────────────
cmd_key_entry() {
  local PUB="" ID="" PURPOSE="" DAYS="" FROM="$TODAY" NOTE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --pub) PUB="$2"; shift 2;; --id) ID="$2"; shift 2;; --purpose) PURPOSE="$2"; shift 2;;
      --days) DAYS="$2"; shift 2;; --from) FROM="$2"; shift 2;; --note) NOTE="$2"; shift 2;;
      -h|--help) usage; exit 0;; *) die_usage "unknown argument: $1";;
    esac
  done
  [ -f "$PUB" ] || die_usage "--pub FILE (cosign.pub) is required"
  printf '%s' "$ID" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || die_usage "--id must match [A-Za-z0-9][A-Za-z0-9._-]* (got '$ID')"
  case "$PURPOSE" in interim|hardware) ;; *) die_usage "--purpose must be interim|hardware";; esac
  case "$DAYS" in ''|*[!0-9]*) die_usage "--days N is required (interim keys: 90, RQ16)";; esac
  is_date "$FROM" || die_usage "--from must be YYYY-MM-DD"
  local fp until
  fp="$(pem_fingerprint < "$PUB")"; [ -n "$fp" ] || die_usage "$PUB has no PEM PUBLIC KEY block"
  until="$(date_add_days "$FROM" "$DAYS")"
  [ -n "$NOTE" ] || NOTE="$PURPOSE key"
  printf '  - id: %s\n    purpose: %s\n    status: active\n    fingerprint: sha256:%s\n    valid_from: %s\n    valid_until: %s\n' "$ID" "$PURPOSE" "$fp" "$FROM" "$until"
  printf '    revoked_on: ""\n    extended_on: ""\n    extension_reason: ""\n    note: %s\n    public_key: |\n' "$(jq -n --arg n "$NOTE" '$n')"
  sed -n '/-----BEGIN PUBLIC KEY-----/,/-----END PUBLIC KEY-----/p' "$PUB" | sed 's/^/      /'
}
cmd_key_status() {  # is the key in PUB a usable trusted key at --at? exit 0 usable, 1 otherwise
  local PUB="" TK="" AT="$TODAY" JSON=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pub) PUB="$2"; shift 2;; --trusted-keys) TK="$2"; shift 2;; --at) AT="$2"; shift 2;;
      --json) JSON=1; shift;; -h|--help) usage; exit 0;; *) die_usage "unknown argument: $1";;
    esac
  done
  [ -f "$PUB" ] || die_usage "--pub FILE is required"
  is_date "$AT" || die_usage "--at must be YYYY-MM-DD (got '$AT')"
  local W fp TKF out
  W="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$W'" EXIT
  fp="$(pem_fingerprint < "$PUB")"; [ -n "$fp" ] || die_usage "$PUB has no PEM PUBLIC KEY block"
  TKF="$(resolve_trusted_keys "$TK")"
  load_trusted_keys "$TKF" "$W"
  out="$(jq -c --arg h "$fp" --arg at "$AT" --arg tk "$TKF" "$KEY_STATE_JQ"'
    ([.[] | select(.fingerprint_hex == $h)][0]) as $k
    | if $k == null then {state:"key-unknown", id:"", fingerprint:("sha256:" + $h), trusted_keys:$tk, at:$at}
      else {state:($k | kstate($at)), id:$k.id, purpose:$k.purpose, status:$k.status, valid_from:$k.valid_from, valid_until:$k.valid_until,
            fingerprint:("sha256:" + $h), trusted_keys:$tk, at:$at} end' "$W/keys.json")"
  if [ "$JSON" = 1 ]; then printf '%s\n' "$out"; else jq -r '"\(.state) \(if .id == "" then "-" else .id end) \(.fingerprint)"' <<<"$out"; fi
  [ "$(jq -r .state <<<"$out")" = usable ] && return "$EX_PASS"
  exit "$EX_UNTRUSTED"
}

# ── exit-codes ───────────────────────────────────────────────────────────────
cmd_exit_codes() {
  local JSON=0
  while [ $# -gt 0 ]; do case "$1" in --json) JSON=1; shift;; -h|--help) usage; exit 0;; *) die_usage "unknown argument: $1";; esac; done
  local rows='0	PASS	gate passed / verification passed
1	ERROR	unclassified tool error (every error was 1 before 1.3.0)
2	FINDINGS	CVEs at or above --fail-on; verify-release: a validly signed FAIL verdict
3	UNAVAILABLE	an external resource could not be got (vulnerability DB download, registry, network)
4	UNTRUSTED	signature does not verify, no usable trusted key, binary != tools.lock, evidence tampered
5	POLICY	allowlist entry incomplete or expired, trusted-keys file malformed, bad --fail-on
64	USAGE	unknown argument, missing required argument, wrong input path'
  if [ "$JSON" = 1 ]; then
    printf '%s\n' "$rows" | jq -R -s --arg v "$TOOLKIT_VERSION" '{toolkit:$v, exit_codes:[split("\n")[] | select(length > 0) | split("\t") | {code:(.[0]|tonumber), name:.[1], meaning:.[2]}]}'
  else
    printf '%s\n' "$rows" | awk -F'\t' '{printf "%-3s %-12s %s\n", $1, $2, $3}'
  fi
}

case "${1:-help}" in
  scan) shift; cmd_scan "$@";;
  verify-release) shift; cmd_verify_release "$@";;
  verify-toolkit) shift; cmd_verify_toolkit "$@";;
  check-tools) shift; cmd_check_tools "$@";;
  key-entry) shift; cmd_key_entry "$@";;
  key-status) shift; cmd_key_status "$@";;
  tools) tool_versions_json;;
  version) printf '%s\n' "$TOOLKIT_VERSION";;
  help|-h|--help) usage;;
  exit-codes) shift; cmd_exit_codes "$@";;
  *) usage; exit "$EX_USAGE";;
esac
